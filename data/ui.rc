<?xml version="1.0" encoding="UTF-8"?>
<gui name="katemark" version="4" xmlns="http://www.kde.org/standards/kxmlgui/1.0">
  <MenuBar>
    <Menu name="tools">
      <Action name="katemark_show" group="tools_operations" />
      <Action name="katemark_export_pdf" group="tools_operations" />
      <Action name="katemark_export_html" group="tools_operations" />
      <Menu name="katemark_markdown" group="tools_operations">
        <text>Markdown</text>
        <Action name="katemark_bold" />
        <Action name="katemark_italic" />
        <Action name="katemark_strikethrough" />
        <Separator />
        <Action name="katemark_heading_up" />
        <Action name="katemark_heading_down" />
        <Separator />
        <Action name="katemark_paste_link" />
        <Action name="katemark_format_table" />
      </Menu>
    </Menu>
  </MenuBar>
  <ToolBar name="mainToolBar" noMerge="0">
    <Action name="katemark_show" />
  </ToolBar>
</gui>
