msgstr "Katdown"

#: src/configpage.cpp:151
#, kde-format
msgid "Checking..."
msgstr "Проверка..."

#: src/configpage.cpp:164
#, kde-format
msgid "Update check failed: %1"
msgstr "Проверката за актуализации е неуспешна: %1"

#: src/configpage.cpp:171
#, kde-format
msgid "Update check failed: no published release found."
msgstr ""
"Проверката за актуализации е неуспешна: не е намерено публикувано издание."

#: src/configpage.cpp:181
#, kde-format
msgid "Update available: %1 (installed %2). <a href=\"%3\">Release notes</a>"
msgstr ""
"Налична е актуализация: %1 (инсталирана версия %2). <a href=\"%3\">Бележки "
"към изданието</a>"

#: src/configpage.cpp:183
#, kde-format
msgid "Up to date (installed %1)."
msgstr "Версията е актуална (инсталирана %1)."

#: src/imagepaste.cpp:30
#, kde-format
msgid ""
"Save the document before pasting an image: the image is stored beside it."
msgstr ""
"Запазете документа, преди да поставите изображение: то се съхранява до него."

