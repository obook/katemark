#: src/imagepaste.cpp:30
#, kde-format
msgid ""
"Save the document before pasting an image: the image is stored beside it."
msgstr ""
"Speichern Sie das Dokument, bevor Sie ein Bild einfügen: Das Bild wird neben "
"dem Dokument gespeichert."

#: src/imagepaste.cpp:39
#, kde-format
msgid "Could not save the image to %1"
msgstr "Das Bild kann nicht unter %1 gespeichert werden"

