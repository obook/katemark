#: src/configpage.cpp:58
#, kde-format
msgid "GitHub"
msgstr "GitHub"

#: src/configpage.cpp:59
#, kde-format
msgid "Match editor / system theme"
msgstr "संपादक / सिस्टम थीम से मिलाएँ"

#: src/configpage.cpp:60
#, kde-format
msgid "Style:"
msgstr "शैली:"

#: src/configpage.cpp:63
#, kde-format
msgid "Follow system (auto)"
msgstr "सिस्टम के अनुसार (स्वचालित)"

#: src/configpage.cpp:64
#, kde-format
msgid "Light"
msgstr "हल्का"

#: src/configpage.cpp:65
