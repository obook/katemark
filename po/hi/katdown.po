#: src/configpage.cpp:171
#, kde-format
msgid "Update check failed: no published release found."
msgstr "अद्यतन की जाँच विफल: कोई प्रकाशित रिलीज़ नहीं मिली।"

#: src/configpage.cpp:181
#, kde-format
msgid "Update available: %1 (installed %2). <a href=\"%3\">Release notes</a>"
msgstr "अद्यतन उपलब्ध: %1 (संस्थापित संस्करण: %2)। <a href=\"%3\">रिलीज़ नोट्स</a>"

#: src/configpage.cpp:183
#, kde-format
msgid "Up to date (installed %1)."
msgstr "अद्यतित (संस्थापित संस्करण: %1)।"

#: src/imagepaste.cpp:30
#, kde-format
msgid ""
"Save the document before pasting an image: the image is stored beside it."
msgstr "छवि चिपकाने से पहले दस्तावेज़ सहेजें: छवि दस्तावेज़ के साथ ही सहेजी जाती है।"

#: src/imagepaste.cpp:39
#, kde-format
msgid "Could not save the image to %1"
msgstr "छवि को %1 में सहेजा नहीं जा सका"

