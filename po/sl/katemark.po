#: src/configpage.cpp:69
#, kde-format
msgid ""
"\"GitHub\" uses GitHub's own colors. \"Match editor / system theme\" "
"recolors the same layout from the active editor theme, so the preview blends "
"with the rest of Kate."
msgstr ""
"\"GitHub\" uporablja lastne barve GitHuba. \"Uskladi s temo urejevalnika / "
"sistema\" isto postavitev obarva po dejavni temi urejevalnika, tako da se "
"predogled zlije s preostalim delom programa Kate."

